# Local Next.js: copy this file to .env.local in the repository root.
# Server-side Express origin. This is the only application variable Vercel needs.
# Vercel Preview: set to your deployed TEST Express HTTPS origin.
# Vercel Production: set to your deployed PRODUCTION Express HTTPS origin.
# Set before building/redeploy after changes. Do not use localhost on Vercel.
# No path, credentials, query parameters, or NEXT_PUBLIC_ prefix.
BACKEND_URL=http://localhost:4000
