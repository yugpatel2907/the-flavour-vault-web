# Copy to .env.local in the project root for local development.
# Configure the same names in Vercel Preview and Production, then redeploy.
# Server-side only. Never prefix these names with NEXT_PUBLIC_.
# Create your private key at https://console.groq.com/keys
GROQ_API_KEY=
# Choose a Groq model with tool calling: https://console.groq.com/docs/models
AI_MODEL=openai/gpt-oss-20b
# Without AI configuration, menu/cart/demo checkout still work.
# No BACKEND_URL, DATABASE_URL, admin secret or separate server is required.
