# Local Express: copy to backend/.env. Run from backend/ or npm --prefix backend.
# Deployed Express: configure these in the backend host, NOT the Next.js project.
# Local development value. Set production on BOTH deployed Preview and Production
# backend hosts; the container already sets production. Test runners may use test.
NODE_ENV=development
# Backend host usually supplies PORT; default is 4000 for local development.
PORT=4000
# Optional locally: empty uses the existing in-memory menu/order fallback.
# Required for durable deployed orders. Preview must use a separate test database.
# Populate privately; never commit database credentials.
DATABASE_URL=
# TLS verifies the certificate chain and hostname by default in every environment.
# Local non-TLS PostgreSQL ONLY: set disable with NODE_ENV=development or test.
# Deployed backends MUST use verify-full and NODE_ENV=production.
# URL ssl*/uselibpqcompat parameters and PGSSLMODE cannot override this policy.
DATABASE_SSL_MODE=verify-full
# Optional: absolute path to a mounted provider CA PEM for private/self-signed CAs.
# Use a trusted provider certificate; never disable
# verification to resolve a certificate error. Leave empty for system CA trust.
DATABASE_SSL_CA_FILE=
# Required only to enable live AI. Missing configuration leaves menu/cart usable.
# Configure separately on Preview and Production Express hosts.
# Create a private key at https://console.groq.com/keys (do not share or commit it).
GROQ_API_KEY=
# Non-secret example: Groq production model supporting application tool calls.
# Confirm it is enabled for your account: https://console.groq.com/docs/models
# This uses your Groq key; no OpenAI API key or built-in execution tools are used.
AI_MODEL=openai/gpt-oss-20b
# Required to enable POST /api/admin/menu-sync; absent disables admin sync only.
# Set a private, random, high-entropy token (at least 32 random bytes recommended).
# Authorized admin clients send Authorization: Bearer <token> over HTTPS.
# Backend-only; never give this token to browser code or a NEXT_PUBLIC_* variable.
# Generate privately when admin sync is needed: openssl rand -hex 32
ADMIN_MENU_SYNC_TOKEN=
